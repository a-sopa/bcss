# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - SCRAPER AI & CACHE PRE-WARM
# ==============================================================================

# Google Gemini AI (obter chave gratuita em: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Fontes de Dados de Eventos (Opcionais)
FOOTBALL_API_KEY=""          # Gratuita em: https://www.football-data.org/client/register
TICKETMASTER_API_KEY=""      # Gratuita em: https://developer.ticketmaster.com/
PREDICTHQ_TOKEN=""           # Trial de 14 dias em: https://www.predicthq.com/

# Ficheiro de Eventos Manuais (já vem configurado por defeito)
EVENTOS_MANUAIS="EventosManuais.json"

# Saída para o Cache Manager (ficheiro JSON com métricas e diretivas de cache)
CACHE_MANAGER_OUTPUT="cache_manager_feed.json"

# Modo de Execução: "1" = simula / apenas mostra logs | "0" = aplica alterações na AWS
DRY_RUN="1"

# Credenciais AWS (Apenas necessárias se executares contra a AWS real com DRY_RUN="0")
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_DEFAULT_REGION="eu-west-3"

# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION - SCRAPER AI & CACHE PRE-WARM
# ==============================================================================

# Google Gemini AI (Get free API key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional Event Data Sources
FOOTBALL_API_KEY=""          # Free tier: https://www.football-data.org/client/register
TICKETMASTER_API_KEY=""      # Free tier: https://developer.ticketmaster.com/
PREDICTHQ_TOKEN=""           # 14-day trial: https://www.predicthq.com/

# Manual Events File path (defaults to ManualEvents.json)
MANUAL_EVENTS="ManualEvents.json"

# Output for Cache Manager (JSON file with zone metrics and cache pre-warming directives)
CACHE_MANAGER_OUTPUT="cache_manager_feed.json"

# Execution Mode: "1" = dry-run / simulation (no AWS charges) | "0" = live provisioning
DRY_RUN="1"

# AWS Credentials (ONLY required if executing against real AWS infrastructure with DRY_RUN="0")
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_DEFAULT_REGION="eu-west-3"
